name: PayProof owner-managed cloud Sandbox candidate108 INACTIVE
on:
  workflow_dispatch:
    inputs:
      public_configuration:
        description: Reviewed public data only; never authority or credentials
        required: true
        type: string
permissions:
  contents: read
jobs:
  sandbox_read:
    if: false # INACTIVE: future activation requires separately reviewed exact delta.
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    environment: payproof-sandbox-readonly
    steps:
      - name: Guard actual caller before checkout and protected injection
        env:
          ACTUAL_EVENT: ${{ github.event_name }}
          ACTUAL_REPOSITORY_ID: ${{ github.repository_id }}
          ACTUAL_OWNER_ID: ${{ github.repository_owner_id }}
          ACTUAL_ACTOR_ID: ${{ github.actor_id }}
          ACTUAL_ATTEMPT: ${{ github.run_attempt }}
          ACTUAL_REF: ${{ github.ref }}
        run: |
          test "$ACTUAL_EVENT" = workflow_dispatch
          test "$ACTUAL_REPOSITORY_ID" = 1419908202
          test "$ACTUAL_OWNER_ID" = 273768139
          test "$ACTUAL_ACTOR_ID" = 273768139
          test "$ACTUAL_ATTEMPT" = 1
          test "$ACTUAL_REF" = refs/heads/main
      - name: Checkout actual source for independent release pin comparison
        uses: actions/checkout@1af3b93b6815bc44a9784bd300feb67ff0d1eeb3
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Prepare bounded public data only
        env:
          PUBLIC_CONFIGURATION: ${{ inputs.public_configuration }}
        run: |
          umask 077
          mkdir -p "$RUNNER_TEMP/payproof108"
          python3 -I -c 'import os,pathlib; b=os.environ["PUBLIC_CONFIGURATION"].encode(); assert len(b)<=16384; pathlib.Path(os.environ["RUNNER_TEMP"],"payproof108","configuration.json").write_bytes(b)'
      - name: Validate external consumed first run and whole source BEFORE credentials
        run: |
          python3 -I -c 'import runpy,sys; sys.path.insert(0,"."); sys.argv=["delivery108","hosted-preflight","--config",sys.argv[1]]; runpy.run_module("tools.sandbox_delivery107",run_name="__main__")' "$RUNNER_TEMP/payproof108/configuration.json"
      # Current preflight returns MISSING_OWN_CAS_FIRST_RUN_JOB_ADAPTER108.
      # Public JSON, ENV metadata and concurrency labels cannot bypass that fact.
      - name: Register the separately authenticated expectation without provider calls
        run: |
          python3 -I -c 'import json,sys; sys.path.insert(0,"."); from payproof.core import Store; c=json.load(open(sys.argv[1])); Store(sys.argv[2]).register(c["order_id"],c["amount"],c["currency"])' "$RUNNER_TEMP/payproof108/configuration.json" "$RUNNER_TEMP/payproof108/orders.sqlite"
      - name: Single already-gated owner-managed runtime step
        env:
          PAYPROOF_PAYPAL_SANDBOX_CLIENT_ID: ${{ secrets.PAYPROOF_PAYPAL_SANDBOX_CLIENT_ID }}
          PAYPROOF_PAYPAL_SANDBOX_CLIENT_SECRET: ${{ secrets.PAYPROOF_PAYPAL_SANDBOX_CLIENT_SECRET }}
        run: |
          python3 -I -c 'import runpy,sys; sys.path.insert(0,"."); sys.argv=["delivery108","github-owner-managed","--config",sys.argv[1],"--database",sys.argv[2],"--journal",sys.argv[3],"--local-ai"]; runpy.run_module("tools.sandbox_delivery107",run_name="__main__")' "$RUNNER_TEMP/payproof108/configuration.json" "$RUNNER_TEMP/payproof108/orders.sqlite" "$RUNNER_TEMP/payproof108/once.sqlite"
      - name: Drop ephemeral files on success or failure
        if: always()
        run: |
          rm -f -- "$RUNNER_TEMP/payproof108/configuration.json" "$RUNNER_TEMP/payproof108/orders.sqlite" "$RUNNER_TEMP/payproof108/orders.sqlite-journal" "$RUNNER_TEMP/payproof108/once.sqlite" "$RUNNER_TEMP/payproof108/once.sqlite-journal"
      # External canonical consumed record is NEVER reset/deleted by this job.
      # No installer, OIDC, upload, external AI or financial mutation.
