name: PayProof operator Sandbox delivery candidate107 INACTIVE
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  sandbox_read:
    if: false # INACTIVE; not under .github/workflows; no execution admission.
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    environment: payproof-sandbox-readonly
    steps:
      - name: Verify actual caller before any protected injection
        env:
          ACTUAL_EVENT: ${{ github.event_name }}
          ACTUAL_REPOSITORY_ID: ${{ github.repository_id }}
          ACTUAL_ACTOR_ID: ${{ github.actor_id }}
          ACTUAL_ATTEMPT: ${{ github.run_attempt }}
          ACTUAL_REF: ${{ github.ref }}
        run: |
          test "$ACTUAL_EVENT" = workflow_dispatch
          test "$ACTUAL_REPOSITORY_ID" = 1419908202
          test "$ACTUAL_ACTOR_ID" = 273768139
          test "$ACTUAL_ATTEMPT" = 1
          test "$ACTUAL_REF" = refs/heads/main
      - name: Exact reviewed source checkout
        uses: actions/checkout@1af3b93b6815bc44a9784bd300feb67ff0d1eeb3
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Require separately reviewed external once and source custody admission
        run: python3 -I -c "import runpy,sys; sys.path.insert(0,'.'); sys.argv=['sandbox_delivery107','hosted-preflight']; runpy.run_module('tools.sandbox_delivery107',run_name='__main__')"
      # hosted-preflight deliberately refuses before secrets are even mapped.
      # Future reviewed successor must verify the exact release/workflow/run,
      # external persistent once receipt and included allowance before injection.
      # Reserved existing contract names, not active env lookups or new secrets:
      # PAYPROOF_PAYPAL_SANDBOX_CLIENT_ID
      # PAYPROOF_PAYPAL_SANDBOX_CLIENT_SECRET
      # No API step until that successor also has an approved noninteractive
      # operator delivery profile. No installer/OIDC/write permission is added.
